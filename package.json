{
  "name": "claude-ecosystem",
  "private": true,
  "version": "1.0.0",
  "description": "Rickus's personal automation ecosystem - PWAs built with Claude",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/dashboard",
    "build": "node tooling/build-all.mjs",
    "test": "npm run test --workspaces --if-present",
    "new-app": "node tooling/new-app.mjs",
    "check:functions": "npx -y deno@2.9.6 check --quiet --no-lock --node-modules-dir=none apps/*/supabase/functions/*/index.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
